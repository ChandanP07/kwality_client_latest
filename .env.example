# ─────────────────────────────────────────────────────────────
# DATABASE
# Same DB as admin app — both apps share one database
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/printcare_db?schema=public"

# ─────────────────────────────────────────────────────────────
# NEXTAUTH
# NEXTAUTH_URL is THIS app's URL (client app)
# NEXTAUTH_SECRET must be IDENTICAL to the admin app's secret
# ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-same-in-both-apps"

# ─────────────────────────────────────────────────────────────
# GOOGLE OAUTH — same credentials as admin app
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ─────────────────────────────────────────────────────────────
# ADMIN API URL
# All /api/client/* calls go here — this is the admin app's URL
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─────────────────────────────────────────────────────────────
# EMAIL
# ─────────────────────────────────────────────────────────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@printcare.com"
